// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String?   // Optional because Google OAuth users won't have a password
  picture   String?   // Google profile picture
  tryouts   Tryout[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tryout {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scoreTotal  Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  questions   Question[]
  userAnswers UserAnswer[]
}

model Question {
  id            String       @id @default(cuid())
  tryoutId      String
  tryout        Tryout       @relation(fields: [tryoutId], references: [id], onDelete: Cascade)
  subject       String       // PU, PK, PM, LB, PBM, etc.
  type          String       // MULTIPLE_CHOICE, SHORT_ANSWER
  text          String       @db.Text
  options       Json?        // Array of options for multiple choice
  correctAnswer String
  explanation   String       @db.Text
  orderIndex    Int          @default(0)
  createdAt     DateTime     @default(now())
  userAnswers   UserAnswer[]
}

model UserAnswer {
  id         String   @id @default(cuid())
  tryoutId   String
  tryout     Tryout   @relation(fields: [tryoutId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswer String
  isCorrect  Boolean?
  createdAt  DateTime @default(now())

  @@unique([tryoutId, questionId])
}
